+def _dy_verify_type(user_info: Dict) -> int:
+    """抖音不给认证数字码，只有文案，这里归一化成：0 无认证 / 1 个人认证 / 2 企业·机构认证 / -1 拿不到用户对象。"""
+    if not user_info:
+        return -1
+    if user_info.get("enterprise_verify_reason"):
+        return 2
+    if user_info.get("custom_verify"):
+        return 1
+    return 0
+
+
+def _dy_verify_desc(user_info: Dict):
+    """认证原文（平台给的那句说明），没有就空着。"""
+    if not user_info:
+        return None
+    return user_info.get("enterprise_verify_reason") or user_info.get("custom_verify") or None
+
