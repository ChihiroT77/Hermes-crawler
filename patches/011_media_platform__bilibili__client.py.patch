 class BilibiliClient(AbstractApiClient, ProxyRefreshMixin):
 
+    # ===== 抓取提速：全局请求闸门（2026-11-09 新增）=====
+    # 同一个 client 实例上所有评论请求共用一把信号量，用来限制「同时在飞」的请求数。
+    # 好处是视频并发 + 评论楼并发叠加时总量依然可控，不会因为相乘把 B 站打爆。
+    _comment_sem: Optional[asyncio.Semaphore] = None
+
+    def _comment_slot(self) -> asyncio.Semaphore:
+        """返回全局评论请求闸门。并发数取 config.BILI_COMMENT_CONCURRENCY，1 即退回旧的串行行为。"""
+        sem = self._comment_sem
+        if sem is None:
+            limit = int(getattr(config, "BILI_COMMENT_CONCURRENCY", 1) or 1)
+            sem = asyncio.Semaphore(max(1, limit))
+            self._comment_sem = sem
+        return sem
+
     def __init__(
         self,
         timeout=60,  # For media crawling, Bilibili long videos need a longer timeout
