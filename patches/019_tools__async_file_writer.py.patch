 class AsyncFileWriter:
+    # 按文件路径共享的跨实例锁：store 层每次落库都会 new 一个 AsyncFileWriter，
+    # 实例级 self.lock 无法串行化不同实例对同一文件的并发追加。
+    # Windows CRT 的 'a' 模式是"seek 到末尾再写"两步动作，不加跨实例锁会中段互相覆盖，
+    # 产生半截坏行（已实测复现：1182 行并发追加坏 2 行）。
+    _path_locks: Dict[str, asyncio.Lock] = {}
+    _registry_guard = threading.Lock()
+
+    @classmethod
+    def _get_path_lock(cls, file_path: str) -> asyncio.Lock:
+        with cls._registry_guard:
+            lock = cls._path_locks.get(file_path)
+            if lock is None:
+                lock = asyncio.Lock()
+                cls._path_locks[file_path] = lock
+            return lock
+
     def __init__(self, platform: str, crawler_type: str):
         self.lock = asyncio.Lock()
         self.platform = platform
