+    def _build_env(self, config: CrawlerStartRequest) -> dict:
+        """Environment for the crawler process.
+
+        Third-party IP proxy providers read their credentials from environment
+        variables, so the WebUI may pass a few of them through. Only names on
+        the allowlist are forwarded, so the payload can never repoint PATH or
+        any other variable the child process relies on.
+        """
+        env = {**os.environ, "PYTHONUNBUFFERED": "1"}
+        for key, value in (config.ip_proxy_credentials or {}).items():
+            if key in _ALLOWED_ENV_OVERRIDES and isinstance(value, str) and value.strip():
+                env[key] = value.strip()
+        return env
+
