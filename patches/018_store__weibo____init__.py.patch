+# 省级行政区名单，仅用于从评论 source（形如「来自 江苏」）里判断到底是不是 IP 属地
+_CN_PROVINCES = (
+    "北京", "天津", "上海", "重庆", "河北", "山西", "辽宁", "吉林", "黑龙江",
+    "江苏", "浙江", "安徽", "福建", "江西", "山东", "河南", "湖北", "湖南",
+    "广东", "海南", "四川", "贵州", "云南", "陕西", "甘肃", "青海", "台湾",
+    "内蒙古", "广西", "西藏", "宁夏", "新疆", "香港", "澳门",
+)
+
+
+def _ip_from_source(raw) -> str:
+    """微博评论的 source 有时是「来自 江苏」这种 IP 属地，有时是「来自 iPhone客户端」这种设备来源。
+    只把能对上省份名的取出来，对不上就留空，不猜。原值另存 comment_source。"""
+    text = str(raw).strip() if raw is not None else ""
+    if text.startswith("来自"):
+        text = text[2:].strip()
+    return text if text in _CN_PROVINCES else ""
+
+
