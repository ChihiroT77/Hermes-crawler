+def _clean_ip_location(raw) -> str:
+    """把 "IP属地：广东" 清洗成 "广东"；缺失时返回空串。"""
+    if not raw:
+        return ""
+    text = str(raw).strip()
+    for prefix in ("IP属地：", "IP属地:", "IP 属地：", "IP 属地:"):
+        if text.startswith(prefix):
+            text = text[len(prefix):].strip()
+            break
+    return text
+
+
+def _extract_ip_location(comment_item: Dict) -> str:
+    """从原始评论里尽量取到 IP 属地，兼容几种可能的落点。"""
+    reply_control = comment_item.get("reply_control") or {}
+    if isinstance(reply_control, dict):
+        got = _clean_ip_location(reply_control.get("location"))
+        if got:
+            return got
+    member = comment_item.get("member") or {}
+    if isinstance(member, dict):
+        got = _clean_ip_location(member.get("location"))
+        if got:
+            return got
+    return _clean_ip_location(comment_item.get("location"))
+
