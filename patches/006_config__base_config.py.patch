 # Crawl interval
-CRAWLER_MAX_SLEEP_SEC = 2
+CRAWLER_MAX_SLEEP_SEC = 2  # [本任务临时修改 2026-11-10] 用户授权：爬取间隔≥5秒、翻页间隔≥3秒（微博全部sleep共用此常量）；原值 = 2，任务结束后恢复 [2026-11-12 任务结束，已恢复原值 2]
+
+# ============ B 站抓取提速开关（2026-11-09 新增） ============
+# 背景：一次 2~3 万条评论的抓取，旧逻辑要跑 70 分钟以上。主要原因是
+#   1) 视频级并发固定为 1，20 个视频排队一个个抓；
+#   2) 每个「有回复的评论楼」都要单独发一次请求，而且是 for 循环串行发；
+#   3) 每次请求后固定 sleep 2 秒，这部分几乎占了一半墙钟时间。
+# 下面三个开关把上面三点都改掉，默认值偏向「稳」而不是「最快」。
+# 想恢复旧行为：把 BILI_COMMENT_CONCURRENCY 设成 1、BILI_COMMENT_SLEEP_SEC 设成 2。
+
+# 全局同时在飞的评论请求数上限（视频之间、评论楼之间共用这一个上限）。
+# 1 = 老逻辑（完全串行）；4 通常能把抓评论这段压到原来的 1/3 左右；
+# 8 更快但更容易触发 B 站风控（412 / 需要验证）。建议不超过 6。
+BILI_COMMENT_CONCURRENCY = 4
+
+# 每次评论请求之后的等待秒数（老逻辑用的是上面的 CRAWLER_MAX_SLEEP_SEC=2）。
+# 0.6 比较稳；出现 412 或评论明显缺失时，调回 1.5 ~ 2。
+BILI_COMMENT_SLEEP_SEC = 0.6
+
+# 跨关键词/跨批次的视频去重：同一个 video_id 的评论只抓一次。
+# B 站搜索是字面匹配，多个关键词（如「尊界V800」和「尊界 刹车踏板」）会命中同一批视频，
+# 不去重就会把同一个视频的几千条评论重复抓两遍、三遍。
+BILI_DEDUPE_VIDEOS = True
 
