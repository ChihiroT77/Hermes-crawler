+type TextFieldProps = {
+  label: string
+  hint?: string
+  value: string
+  onChange: (value: string) => void
+  placeholder?: string
+  disabled?: boolean
+  type?: string
+}
+
+function TextField({ label, hint, value, onChange, placeholder, disabled, type = 'text' }: TextFieldProps) {
+  return (
+    <Field label={label} hint={hint}>
+      <Input
+        type={type}
+        value={value}
+        onChange={(e) => onChange(e.target.value)}
+        placeholder={placeholder}
+        disabled={disabled}
+        className="h-9 text-xs"
+      />
+    </Field>
+  )
+}
+
+type NumberFieldProps = {
+  label: string
+  hint?: string
+  value: number
+  onChange: (value: number) => void
+  min?: number
+  max?: number
+  disabled?: boolean
+  presets?: { label: string; value: number }[]
+}
+
+function NumberField({ label, hint, value, onChange, min = 1, max, disabled, presets }: NumberFieldProps) {
+  return (
+    <Field label={label} hint={hint}>
+      <Input
+        type="number"
+        min={min}
+        max={max}
+        value={value > 0 ? String(value) : ''}
+        onChange={(e) => {
+          const raw = e.target.value
+          if (raw.trim() === '') {
+            onChange(0)
+            return
+          }
+          const parsed = Number(raw)
+          onChange(Number.isFinite(parsed) ? parsed : 0)
+        }}
+        disabled={disabled}
+        className="h-9 text-xs font-mono"
+      />
+      {presets && presets.length > 0 ? (
+        <div className="flex flex-wrap gap-1.5">
+          {presets.map((preset) => (
+            <button
+              key={preset.label}
+              type="button"
+              disabled={disabled}
+              onClick={() => onChange(preset.value)}
+              className={`px-2 py-1 rounded border text-[10px] font-mono transition-colors disabled:opacity-50 ${
+                value === preset.value
+                  ? 'border-cyber-neon-cyan/60 bg-cyber-neon-cyan/15 text-cyber-neon-cyan'
+                  : 'border-cyber-border-subtle text-cyber-text-muted hover:border-cyber-border-DEFAULT hover:text-cyber-text-secondary'
+              }`}
+            >
+              {preset.label}
+            </button>
+          ))}
+        </div>
+      ) : null}
+    </Field>
+  )
+}
+
+type SelectFieldProps = {
+  label: string
+  hint?: string
+  value: string
+  onChange: (value: string) => void
+  options: { value: string; label: string }[]
+  disabled?: boolean
+  placeholder?: string
+}
+
+function SelectField({ label, hint, value, onChange, options, disabled, placeholder }: SelectFieldProps) {
+  return (
+    <Field label={label} hint={hint}>
+      <Select value={value} onValueChange={onChange} disabled={disabled}>
+        <SelectTrigger className="h-9 text-xs">
+          <SelectValue placeholder={placeholder} />
+        </SelectTrigger>
+        <SelectContent>
+          {options.map((option) => (
+            <SelectItem key={option.value} value={option.value}>
+              {option.label}
+            </SelectItem>
+          ))}
+        </SelectContent>
+      </Select>
+    </Field>
+  )
+}
+
+type CheckboxFieldProps = {
+  label: string
+  hint?: string
+  checked: boolean
+  onChange: (checked: boolean) => void
