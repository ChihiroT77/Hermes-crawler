{
  "name": "dsh-hermes",
  "version": "0.1.0",
  "type": "module",
  "description": "Hermes 爬虫插件（dsh 外壳）：把 MediaCrawler 封装成 AI agent 可调用的工具。B 站/抖音/微博/知乎内容与评论采集，导出 Excel/CSV/JSON。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "crawler",
    "mediacrawler",
    "bilibili",
    "douyin"
  ],
  "license": "SEE LICENSE IN LICENSE-NOTICE.md",
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-0 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
