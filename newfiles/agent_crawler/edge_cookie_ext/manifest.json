{
  "manifest_version": 3,
  "name": "爬虫登录票导出",
  "version": "1.8",
  "description": "把本机 Edge 里已登录平台的 cookie 导出成 JSON，供 MediaCrawler 免扫码使用。登录后会自动导出，也可以点按钮手动导。只导出下面这几个平台，不碰别的网站。",
  "permissions": [
    "cookies",
    "downloads",
    "offscreen",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.weibo.com/*",
    "*://*.weibo.cn/*",
    "*://*.sina.com.cn/*",
    "*://*.douyin.com/*",
    "*://*.kuaishou.com/*",
    "*://*.xiaohongshu.com/*",
    "*://*.baidu.com/*",
    "*://*.zhihu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "导出登录票",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
